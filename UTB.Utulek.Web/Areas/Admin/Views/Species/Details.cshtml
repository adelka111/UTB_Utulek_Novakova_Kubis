@model Species
@{
    ViewData["Title"] = "Detail druhu";
}
<h1>@ViewData["Title"]</h1>

<div class="row">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <h2 class="card-title h3">@Model.Name</h2>

                <dl class="row mb-0">
                    <dt class="col-sm-4">Název</dt>
                    <dd class="col-sm-8">@Model.Name</dd>
                </dl>
            </div>
        </div>

        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Upravit</a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirmDelete(this)" data-name="@Model.Name" data-title="Smazat druh?">
            <button type="submit" class="btn btn-danger">Smazat</button>
        </form>
        <a asp-action="Index" class="btn btn-secondary">Zpět</a>
    </div>
</div>

@section Scripts {
    <script src="~/js/dialog.js" asp-append-version="true"></script>
}
